# ---------------------------------------------------------------------------
# Enterprise RAG - environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# json (production, log aggregation) | console (local dev)
LOG_FORMAT=console
# Comma-separated allowed CORS origins, or * for all
CORS_ORIGINS=*

# --- Embedding (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_BATCH_SIZE=32
EMBED_TIMEOUT_SECONDS=60
EMBED_MAX_RETRIES=3

# --- LLM (answer generation) ---
# provider: ollama | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
LLM_REQUEST_TIMEOUT_SECONDS=10

# --- OpenAI (GPT / vision / Whisper speech-to-text) ---
# Switch LLM_PROVIDER=openai and set your key to use GPT-4o / GPT-4.1:
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o
#   OPENAI_API_KEY=sk-...
# Speech transcription (mic button) uses OPENAI_API_KEY + WHISPER_MODEL.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- Vision chat ---
VISION_MAX_IMAGES=4
VISION_MAX_IMAGE_BYTES=10485760

# --- Vector store (embedded ChromaDB by default) ---
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=enterprise_rag
# Set to true + host/port to use a remote Chroma server instead
CHROMA_SERVER_ENABLED=false
CHROMA_SERVER_HOST=chroma
CHROMA_SERVER_PORT=8000

# --- Sparse index ---
BM25_INDEX_PATH=./data/bm25_index.pkl

# --- Retrieval ---
DENSE_TOP_K=50
SPARSE_TOP_K=50
HYBRID_TOP_K=20
FINAL_TOP_K=5
RRF_K=60

# --- Re-ranking ---
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MAX_DOCS=50

# --- Caching ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=512

# --- Ingestion ---
DEFAULT_CHUNK_SIZE=512T
# Optional extras for reading embedded PDF images: pip install -e ".[ocr]"

# --- RBAC / Auth ---
# In production this MUST be a random value of at least 32 characters; the app
# refuses to boot with ENVIRONMENT=production without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_ENABLED=true
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRY_SECONDS=3600
AUTH_ISSUER=enterprise-rag
AUTH_AUDIENCE=enterprise-rag
# Credential-endpoint throttling (per client IP, sliding window).
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Audit ---
AUDIT_ENABLED=true
